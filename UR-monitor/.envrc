# Node.js environment setup
# Check if node is available in PATH
if command -v node >/dev/null 2>&1; then
    NODE_VERSION=$(node --version | sed 's/v//')
    echo "Using system Node.js version: $NODE_VERSION"
    export PATH="$PATH"
else
    echo "Node.js not found in PATH. Please install Node.js 18 or later."
    echo "You can install it via:"
    echo "  - Homebrew: brew install node"
    echo "  - Official installer: https://nodejs.org/"
    echo "  - nvm: nvm install 18 && nvm use 18"
fi

# Load environment variables from .env file
dotenv

echo "# Usage: npm run dev"
