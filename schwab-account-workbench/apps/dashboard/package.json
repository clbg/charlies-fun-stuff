{
  "name": "schwab-viewer-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Schwab Account Workbench — typed React rewrite of the static viewer.",
  "scripts": {
    "predev": "node scripts/dataToJson.mjs",
    "dev": "vite",
    "prebuild": "node scripts/dataToJson.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "data": "node scripts/dataToJson.mjs"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.0.0"
  }
}
