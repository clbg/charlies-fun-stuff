{
  "name": "japanese-reader",
  "version": "0.1.0",
  "description": "Adaptive Japanese reader: paste text → bilingual translation + word/grammar annotations driven by familiarity.",
  "private": true,
  "type": "module",
  "scripts": {
    "seed": "tsx src/seed.ts",
    "analyze": "tsx src/analyze.ts",
    "server": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.700.0",
    "@aws-sdk/client-polly": "^3.1061.0",
    "@aws-sdk/credential-providers": "^3.700.0",
    "better-sqlite3": "^11.5.0",
    "csv-parse": "^5.5.6",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
