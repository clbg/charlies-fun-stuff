{
  "name": "japanese-reader-cf",
  "version": "0.1.0",
  "description": "Japanese Reader on Cloudflare Workers (Hono + D1 + KV + Gemini, React frontend).",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "vite build",
    "dev": "npm run build:web && wrangler dev",
    "dev:web": "vite",
    "deploy": "npm run build:web && wrangler deploy",
    "d1:local": "wrangler d1 migrations apply japanese-reader --local",
    "d1:remote": "wrangler d1 migrations apply japanese-reader --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "wrangler": "^4.0.0"
  }
}
